# Copiá este archivo como .env y poné tu clave (o usá 2_poner_clave.bat).
# El archivo .env NO se sube a GitHub.

# Claude (el proveedor por defecto, ver config.yaml -> proveedor).
# Se saca en https://platform.claude.com/settings/keys
# Se paga por uso: un partido entero sale alrededor de US$ 5. El tope por
# partido está en config.yaml (claude.tope_usd_por_partido).
ANTHROPIC_API_KEY=

# Gemini (solo si ponés "proveedor: gemini" en config.yaml).
# Gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# App web (Vercel): la dirección de la base de datos compartida. La compu la
# usa para recibir los pedidos de análisis. Se copia de Vercel → Storage.
DATABASE_URL=
